# Public by design: RLS protects the data. Values come from `supabase status -o env` locally
# (API_URL, ANON_KEY) or the Supabase dashboard in production.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Integration tests only (tests/integration). No VITE_ prefix on purpose, so Vite never
# exposes it to the client bundle. Local value from `supabase status -o env` (SERVICE_ROLE_KEY).
# Never set this in Cloudflare Pages.
SUPABASE_SERVICE_ROLE_KEY=
